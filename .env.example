# OpenAI API Key (Required for GPT-4o-mini worker and evaluator)
OPENAI_API_KEY=your_openai_api_key_here

# Google Serper API Key (Required for Serper web search)
SERPER_API_KEY=your_serper_api_key_here

# Pushover Notifications (Optional for mobile/desktop push alerts)
PUSHOVER_USER=your_pushover_user_key_here
PUSHOVER_TOKEN=your_pushover_app_token_here

# LangSmith Tracing & Observability (Optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=sidekick
